<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= event.title %></title><link rel="stylesheet" href="/style.css"></head>
<body><div class="wrap" style="max-width:760px">
<a href="/">&larr; All events</a>
<% const taken = event.attendees.length; %>
<header class="hero">
  <h1><%= event.title %></h1>
  <p><%= event.venue %> &nbsp;·&nbsp; <%= new Date(event.date).toDateString() %>
     &nbsp;·&nbsp; <a href="/events/<%= event._id %>/edit">Edit</a></p>
</header>

<div class="panel">
  <p><%= event.description %></p>
  <div class="meter"><i style="width:<%= Math.min(100, taken / event.capacity * 100) %>%"></i></div>
  <p class="meta"><%= taken %> / <%= event.capacity %> going · <%= event.capacity - taken %> spots left</p>
</div>

<div class="panel">
  <h2 style="margin-top:0">Register</h2>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form class="row" method="post" action="/events/<%= event._id %>/register">
    <input name="name" placeholder="Your name" required>
    <input type="email" name="email" placeholder="Email" required>
    <button>Register</button>
  </form>
</div>

<div class="panel">
  <h2 style="margin-top:0">Who's going</h2>
  <% if (!taken) { %><p class="meta">No one registered yet.</p><% } %>
  <ul class="people">
  <% event.attendees.forEach(a => { %>
    <li><div class="avatar"><%= a.name.charAt(0).toUpperCase() %></div>
        <div class="who"><%= a.name %><small><%= a.email %></small></div>
        <form method="post" action="/events/<%= event._id %>/unregister">
          <input type="hidden" name="email" value="<%= a.email %>">
          <button class="danger small">Cancel</button></form></li>
  <% }) %>
  </ul>
</div>
</div></body></html>
