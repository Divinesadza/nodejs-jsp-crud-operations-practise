<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Events Zimbabwe</title><link rel="stylesheet" href="/style.css"></head>
<body><div class="wrap">
<header class="hero">
  <h1>Out <em>tonight</em></h1>
  <p>Upcoming events around town.</p>
</header>

<form class="bar" method="get" action="/">
  <input name="q" value="<%= q %>" placeholder="Search events...">
  <button class="ghost">Search</button>
  <a class="btn" href="/events/new">+ New event</a>
</form>

<% if (!events.length) { %>
  <div class="empty">No events yet.</div>
<% } %>

<div class="grid">
<% events.forEach(e => { const d = new Date(e.date), taken = (e.attendees||[]).length; %>
  <div class="card">
    <div class="top">
      <div class="date-badge"><b><%= d.getDate() %></b><span><%= d.toLocaleString('en', {month:'short'}) %></span></div>
      <h3><a href="/events/<%= e._id %>"><%= e.title %></a></h3>
    </div>
    <div class="body">
      <p class="meta"><%= e.venue %></p>
      <div class="meter"><i style="width:<%= Math.min(100, taken / e.capacity * 100) %>%"></i></div>
      <p class="meta"><%= taken %> / <%= e.capacity %> going</p>
      <div class="actions">
        <a class="btn small" href="/events/<%= e._id %>">View</a>
        <a class="btn ghost small" href="/events/<%= e._id %>/edit">Edit</a>
        <form method="post" action="/events/<%= e._id %>/delete" onsubmit="return confirm('Delete this event?')">
          <button class="danger small">Delete</button></form>
      </div>
    </div>
  </div>
<% }) %>
</div>
</div></body></html>
